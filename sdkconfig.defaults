# Hardware and image layout
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The board exposes the ESP32-C6 native USB Serial/JTAG interface.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# The supervisor copies a complete fixed aircraft snapshot while starting the
# LAN HTTP server.  The ESP-IDF default main-task stack is too small for that
# bounded call chain on ESP32-C6; retain measured production margin.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Favor flash headroom for the dual-slot OTA layout.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# The LVGL port owns notification index 0; the shared-SPI flush completion
# path uses index 1 so the two event streams cannot consume each other.
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=2
CONFIG_FREERTOS_SUPPORT_STATIC_ALLOCATION=y

# Keep LVGL's upstream examples and demos out of this firmware build.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set

# Keep the stacks that AirTrack does not use out of the image and heap.
# CONFIG_BT_ENABLED is not set
# CONFIG_IEEE802154_ENABLED is not set

# adsb.fi must use verified HTTPS. Keep a full-size inbound TLS record while
# allocating TLS buffers only when they are needed.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096

# Setup clients must send DNS queries to AirTrack so wildcard captive DNS can
# direct platform connectivity probes to the local portal.
CONFIG_LWIP_DHCPS_ADD_DNS=y

# LVGL fonts used by the tracking screen: 10/12 captions and footer, 16 data
# rows, 20 headlines, 28 callsign, 40 distance.  Montserrat 14 stays as the
# default for the setup and diagnostic screens.
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y

# Sighting logs are named YYYY-MM-DD.ndjson, which needs FAT long filenames.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64

# Firmware updates from the dashboard: a freshly installed image must mark
# itself valid after a self-test, otherwise the bootloader returns to the
# previous slot.  Bootloader option: reflash the bootloader once over USB.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
